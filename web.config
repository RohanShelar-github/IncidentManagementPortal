<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- ARR proxies requests locally; the Node listener is never exposed by IIS. -->
    <proxy enabled="true" preserveHostHeader="true" />
    <rewrite>
      <rules>
        <!-- IIS treats an empty URL as the site directory; proxy it explicitly. -->
        <rule name="AOC Incident Portal root reverse proxy" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="http://127.0.0.1:5500/" />
        </rule>
        <rule name="AOC Incident Portal reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5500/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
