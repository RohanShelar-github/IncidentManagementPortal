MAIL_ENABLED=false
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraccount@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=youraccount@gmail.com
MAIL_TO=recipient@example.com
MAIL_CC=cc@example.com
MAIL_BCC=bcc1@example.com,bcc2@example.com
PORTAL_BASE_URL=http://your-portal-host:5500
# Required: generate a unique random value (at least 32 characters) for every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=8h

# Incident Copilot: local Ollama is the default. Install Ollama and pull the
# configured model on the same machine as the backend.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional hosted Groq Incident Copilot. Set AI_PROVIDER=groq and add a Groq
# API key to backend/.env.local. This keeps models off the portal machine. Never put an actual key in this example file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI Incident Copilot (backend only). Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low

# Microsoft 365 Graph settings (recommended for service-principal authentication).
# Set MAIL_PROVIDER=graph and grant/admin-consent Mail.Send. Mail.Read is needed
# only when an inbound-mail workflow is enabled.
MAIL_TENANT_ID=your-tenant-id
MAIL_CLIENT_ID=your-application-client-id
MAIL_CLIENT_SECRET=your-client-secret
# The single Operations mailbox used for alert, ticket, inbox and Sent Items views.
MAIL_INBOX_ADDRESS=aoc@magicsw365.onmicrosoft.com
# Jira Automation customer-ticket subject rule. Change only when the automation template changes.
JIRA_CUSTOMER_TICKET_SUBJECT_PREFIX=A new support issue

# Microsoft 365 EWS settings below are only needed when MAIL_PROVIDER=ews.
# It uses the same tenant/client/secret fields above, plus a delegated token.
MAIL_OAUTH_REFRESH_TOKEN=refresh-token-from-the-delegated-oauth-flow
MAIL_OAUTH_ACCESS_TOKEN=
MAIL_SCOPE=offline_access https://outlook.office365.com/EWS.AccessAsUser.All
MAIL_TOKEN_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token
MAIL_EWS_URL=https://outlook.office365.com/EWS/Exchange.asmx
