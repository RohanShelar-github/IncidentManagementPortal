# Copy to backend/.env.local on the server and provide real values there.
# Never commit a file containing live credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=incident_portal
DB_PASSWORD=replace-with-a-secret
DB_NAME=incident_management_db
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRY=8h
CORS_ORIGIN=http://aocincident.com
MAIL_PROVIDER=graph
MAIL_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-mailbox-address
SMTP_APP_PASSWORD=replace-with-app-password
MAIL_FROM=replace-with-mailbox-address
MAIL_TO=replace-with-default-recipient
MAIL_CC=
MAIL_BCC=
PORTAL_BASE_URL=http://aocincident.com

# Incident Copilot. Use Ollama locally or select Groq/OpenAI with a server-side key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=replace-with-provider-key-if-used
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=replace-with-provider-key-if-used
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=low

# Microsoft 365 Graph service-principal mail configuration.
MAIL_TENANT_ID=replace-with-tenant-id
MAIL_CLIENT_ID=replace-with-client-id
MAIL_CLIENT_SECRET=replace-with-client-secret
MAIL_INBOX_ADDRESS=replace-with-mailbox-address
JIRA_CUSTOMER_TICKET_SUBJECT_PREFIX=A new support issue

# EWS is optional and requires the EWS.AccessAsUser.All delegated permission.
MAIL_OAUTH_REFRESH_TOKEN=replace-with-refresh-token-if-used
MAIL_OAUTH_ACCESS_TOKEN=replace-with-access-token-if-used
MAIL_SCOPE=https://outlook.office365.com/EWS.AccessAsUser.All
MAIL_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
MAIL_EWS_URL=https://outlook.office365.com/EWS/Exchange.asmx
